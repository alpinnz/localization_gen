// /// Common module (Indonesian)
// ///
// /// Summary
// /// - Ini adalah file JSONC **referensi/spec + dataset contoh** untuk module `common` (ID).
// /// - Semua contoh di file ini **modular-only**: berisi `@@locale` dan `@@module`.
// ///
// /// Penggunaan (disarankan)
// /// 1) Baca file ini untuk memahami case localization yang didukung.
// /// 2) Salin polanya ke file `.json` real di folder localization kamu.
// ///
// /// Aturan / Konvensi
// /// - Key adalah API: hindari rename key yang sudah dipakai.
// /// - Placeholder berbentuk `{name}`.
// /// - JSONC bisa komentar; generator membaca `.json`.
// ///
// /// Kebijakan modular
// /// - Setiap file WAJIB punya `@@locale` dan `@@module`.
// /// - `@@module` default di sini adalah `common`.
// ///
// ─────────────────────────────────────────────────────────────────────────────
// CASE INDEX (all cases appear once)
//
//  1) @@locale metadata
//     - Example: @@locale
//
//  2) @@module metadata (wajib; default: common)
//     - Example: @@module
//
//  3) Basic strings
//     - Example: strings.app_title
//
//  4) Nested keys (flatten to dot-keys)
//     - Example: simple.app.settings.security.password.change.title
//
//  5) Placeholders (named parameters)
//     - Example: placeholders.welcome_user => "Selamat datang, {name}."
//
//  6) Multiple parameters in one message
//     - Example: placeholders.full_name => "Halo, {first_name} {last_name}."
//
//  7) Parameter reordering across locales
//     - Example: placeholders.items_in_city
//
//  8) Per-key metadata via @<key> (dartdoc-friendly)
//     - Example: placeholders.@welcome_user
//
//  9) Newline escaping (\\n)
//     - Example: formatting.multiline => "Baris 1\\nBaris 2"
//
// 10) Quote escaping (\\")
//     - Example: formatting.quotes
//
// 11) Unicode punctuation
//     - Example: formatting.unicode
//
// 12) Simbol di dalam string (dot/slash/colon/@/#/dll.)
//     - Example: symbols.version_tag
//
// 13) Literal tokens that must NOT be treated as placeholders
//     - Example: literals.double_curly, literals.square_brackets
//
// 14) Literal braces "{" and "}" (edge-case for tokenizers)
//     - Example: literals.literal_braces
//
// 15) Structured localization forms: @plural / @gender / @context
//     - Example: structured.items.@plural
//
// Terminology
// - "Key path" adalah hasil flatten dari nested.
// - "Placeholder" adalah token bernama dalam bentuk `{name}`.
{
  /// (1) @@locale metadata (wajib)
  ///
  /// Ringkasan
  /// - Menentukan locale untuk file ini.
  ///
  /// Aturan
  /// - Gunakan tag bahasa mirip BCP-47 yang app kamu dukung (mis. `en`, `id`, `en-US`).
  /// - Semua file modular dengan locale yang sama akan di-merge.
  ///
  /// Penggunaan
  /// - Dipakai parser untuk grouping file berdasarkan locale.
  ///
  /// Contoh
  /// - `"@@locale": "id"`
  "@@locale": "id",

  /// (2) @@module metadata (wajib; default: common)
  ///
  /// Ringkasan
  /// - Menentukan nama module untuk file ini.
  ///
  /// Aturan
  /// - Wajib (repo ini modular-only).
  /// - Rekomendasi nilai: `common`, `auth`, `home`, `settings`.
  /// - Nama module sebaiknya konsisten dengan penamaan file.

  /// Penggunaan
  /// - Membantu pengorganisasian file dan mencegah collision key saat merge.
  ///
  /// Contoh
  /// - `"@@module": "common"`
  "@@module": "common",

  /// (3) Basic strings (tanpa placeholder)
  ///
  /// Ringkasan
  /// - Teks biasa tanpa token `{placeholder}`.
  ///
  /// Aturan
  /// - Key dianggap API publik: jangan rename sembarangan.
  /// - Gunakan nama key yang singkat dan semantik.
  ///
  /// Penggunaan (Dart)
  /// - `localizations.strings.app_title`
  ///
  /// Contoh key path
  /// - `strings.app_title`
  "strings": {
    "app_title": "Aplikasi Demo",
    "powered_by": "Didukung oleh Alpinnz"
  },

  /// (4) Nested keys (di-flatten jadi dot-keys)
  ///
  /// Ringkasan
  /// - Object bertingkat akan di-flatten menjadi path key bertitik.
  ///
  /// Aturan
  /// - Kedalaman yang disarankan: 1–6 level.
  /// - Jika strict validation aktif, semua locale WAJIB punya set flattened key yang sama.
  ///
  /// Penggunaan (Dart)
  /// - `localizations.simple.app.settings.security.password.change.title`
  ///
  /// Contoh key path
  /// - `simple.app.settings.security.password.change.title`
  "simple": {
    "hello": "Halo",
    "welcome": { "title": "Selamat datang" },
    "settings": { "profile": { "title": "Profil" } },
    "app": {
      "settings": {
        "security": {
          "password": {
            "change": { "title": "Ubah kata sandi" }
          }
        }
      }
    }
  },

  /// (5) Placeholders (named parameters)
  ///
  /// Ringkasan
  /// - String dapat berisi token `{name}` yang akan menjadi named parameter di Dart.
  ///
  /// Aturan
  /// - Nama placeholder sebaiknya seperti identifier (snake_case disarankan).
  /// - Set placeholder harus sama di semua locale untuk key yang sama.
  ///
  /// Penggunaan (Dart)
  /// - `localizations.placeholders.welcome_user(name: 'John')`
  ///
  /// Contoh
  /// - "Selamat datang, {name}."
  "placeholders": {
    "welcome_user": "Selamat datang, {name}.",
    "attempts_left": "Kamu masih punya {attempts} kesempatan.",
    "remaining_time": "Coba lagi dalam {remaining_time}.",
    "invalid_character": "Karakter {char} tidak diperbolehkan.",

    /// (6) Multiple parameters
    ///
    /// Ringkasan
    /// - Satu string bisa memiliki lebih dari satu placeholder.
    ///
    /// Penggunaan (Dart)
    /// - `localizations.placeholders.full_name(first_name: 'A', last_name: 'B')`
    "full_name": "Halo, {first_name} {last_name}.",

    /// (7) Parameter reordering antar bahasa
    ///
    /// Ringkasan
    /// - Bahasa berbeda boleh menukar urutan placeholder di kalimat.
    ///
    /// Aturan
    /// - Validasi membandingkan *set* placeholder, bukan urutannya.
    ///
    /// Contoh
    /// - EN: "{count} items in {city}."
    /// - ID: "Di {city} ada {count} item."
    "items_in_city": "Di {city} ada {count} item.",

    /// (8) Per-key metadata via @<key> (dartdoc-friendly)
    ///
    /// Ringkasan
    /// - Tambahkan dokumentasi di samping key dengan membuat sibling `@<key>`.
    ///
    /// Aturan
    /// - Key metadata BUKAN translation.
    /// - Simpan docs placeholder di `placeholders` agar mudah dipakai tooling.
    ///
    /// Penggunaan
    /// - Bisa di-embed ke dartdoc hasil generate.
    "@welcome_user": {
      "description": "Menyapa user berdasarkan nama.",
      "example": "Selamat datang, John.",
      "placeholders": { "name": "Nama tampilan user" }
    },
    "@remaining_time": {
      "description": "Petunjuk retry; {remaining_time} adalah string yang sudah terformat seperti 02:15.",
      "example": "Coba lagi dalam 02:15.",
      "placeholders": { "remaining_time": "Sisa waktu untuk retry, sudah terformat" }
    },
    "@items_in_city": {
      "description": "Menampilkan jumlah item dan nama kota. Urutan placeholder bisa berbeda antar bahasa.",
      "example": "Di Jakarta ada 12 item.",
      "placeholders": { "count": "Jumlah item", "city": "Nama kota" }
    }
  },

  /// (9) Newline escaping (\\n)
  ///
  /// Ringkasan
  /// - Gunakan `\\n` untuk menyisipkan newline pada string hasil render.
  ///
  /// Contoh
  /// - "Baris 1\\nBaris 2"
  "formatting": {
    "multiline": "Baris 1\nBaris 2",

    /// (10) Quote escaping
    ///
    /// Ringkasan
    /// - Escape tanda kutip ganda sebagai `\\"` di dalam string JSON.
    "quotes": "Aktifkan \"remember me\" agar tetap masuk.",

    /// (11) Unicode punctuation
    ///
    /// Ringkasan
    /// - Karakter unicode sebaiknya dipertahankan apa adanya (ellipsis, en-dash, dll).
    "unicode": "Jangan khawatir… tidak apa-apa – lanjutkan."
  },

  /// (12) Simbol di dalam string
  ///
  /// Ringkasan
  /// - Value translation boleh berisi simbol/tanda baca seperti `.`, `:`, `/`, `@`, `#`, `&`, `()`.
  /// - Case ini memastikan proses escape/serialize tidak menghilangkan atau salah menafsirkan simbol.
  ///
  /// Aturan
  /// - Ini teks biasa (BUKAN placeholder) kecuali ada pola `{name}`.
  /// - Kalau butuh backslash `\\`, pastikan sudah di-escape benar di JSON.
  ///
  /// Contoh
  /// - "v1.2.3 (build: 45) / api: https://example.com"
  "symbols": {
    "version_tag": "v1.2.3 (build: 45) / api: https://example.com",
    "email_like": "Kontak: support@example.com",
    "hash_like": "Tiket #12345: dibuka ulang",
    "path_like": "Buka: Pengaturan > Akun > Keamanan",

    // Masked values (PIN/OTP). Bullet characters are common in UI.
    "masked_pin": "PIN: ••••",
    "masked_otp": "OTP: ••••••••",

    // Legal / brand symbols that may appear in UI copy.
    "copyright_notice": "© 2026 Alpinnz. Hak cipta dilindungi.",
    "registered_mark": "Merek®",
    "trademark_notice": "Acme™ adalah merek dagang milik Acme Corp.",

    // Common UI symbol patterns.
    "currency_and_amount": "Total: $12.50 / Rp 10.000",
    "percent_like": "Progres: 75%",
    "math_like": "Rentang: 10–20 (±2)",
    "degree_like": "Suhu: 23°C",
    "arrow_like": "Lanjut →",
    "pipe_like": "Privasi | Ketentuan",
    "bullet_list_like": "• Item 1\n• Item 2\n• Item 3",

    // URL / query-string symbols are common for help text.
    "url_query_like": "Buka: https://example.com/?q=a+b&sort=asc"
  },

  /// (13) Token literal yang tidak boleh dianggap placeholder
  ///
  /// Ringkasan
  /// - Beberapa UI butuh menampilkan karakter yang mirip token.
  ///
  /// Aturan
  /// - Tokenizer/validator tidak boleh menganggap ini sebagai `{placeholder}`.
  "literals": {
    "double_curly": "Contoh nomor tersamarkan: {{08-****-1234}}",
    "square_brackets": "Contoh token literal: [x]",

    /// (14) Literal braces "{" dan "}"
    ///
    /// Ringkasan
    /// - Case ini memastikan `{` dan `}` bisa ditulis secara literal.
    "literal_braces": "Gunakan kurung kurawal seperti ini: { dan }"
  },

  /// (15) Structured localization forms: @plural / @gender / @context
  ///
  /// Ringkasan
  /// - Bentuk terstruktur untuk kebutuhan format advanced.
  /// - Dibuat ter-group agar validasi bisa mendeteksi bentuk datanya.
  "structured": {
    "items": {
      "@plural": {
        "zero": "Tidak ada item",
        "one": "Satu item",
        "other": "{count} item"
      },
      "@items": {
        "description": "Bentuk plural untuk jumlah item.",
        "placeholders": { "count": "Jumlah item" }
      }
    },
    "user_title": {
      "@gender": {
        "male": "Tn. {last_name}",
        "female": "Nn. {last_name}",
        "other": "Sdr. {last_name}"
      },
      "@user_title": {
        "description": "Pemilihan sapaan berdasarkan gender.",
        "placeholders": { "last_name": "Nama belakang" }
      }
    },
    "greeting": {
      "@context": {
        "formal": "Selamat pagi, {name}.",
        "casual": "Hai, {name}!"
      },
      "@greeting": {
        "description": "Pemilihan greeting berdasarkan context (formal vs santai).",
        "placeholders": { "name": "Nama tampilan user" }
      }
    }
  }
}
