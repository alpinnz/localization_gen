// /// Localization JSONC reference (English)
// ///
// /// Summary
// /// - This JSONC file is a **developer-readable spec + example dataset**.
// /// - It documents every supported/expected localization "case" exactly once.
// /// - Copy its patterns into your real locale files.
// ///
// /// Usage (recommended)
// /// 1) Read this file to understand the supported shapes.
// /// 2) Implement real translations in `assets/localizations/*.json` (pure JSON, no comments).
// /// 3) Enable `strict_validation: true` to enforce:
// ///    - same flattened keys across locales
// ///    - same placeholder sets across locales
// ///
// /// Examples
// /// - Nested key access (conceptually):
// ///   `simple.deep.level1.level2.message`
// /// - Placeholder call (Dart, generated API):
// ///   `placeholders.welcome_user(name: 'John')`
// ///
// /// Rules / Conventions
// /// - Keys are API: avoid renaming existing keys.
// /// - Placeholders are `{name}` tokens. Keep names identifier-like (e.g., `{remaining_time}`),
// ///   avoid legacy tokens like `{mm:ss}` for new strings.
// /// - Locales may reorder placeholders, but must keep the same placeholder set.
// /// - `@<key>` objects are metadata blocks (dartdoc-friendly). Use them for
// ///   `description`, `example`, and placeholder docs.
// /// - JSONC supports comments; **the generator reads `.json`**.
// ///
// /// Modular vs non-modular
// /// - Non-modular (default): **one file per locale**.
// ///   - There is NO concept of a "default @@module".
// ///   - Instead, group keys by objects at the root (e.g. `auth`, `common`, `settings`).
// ///   - Flattened keys will include the group name: `auth.login.title`.
// ///
// /// - Modular: **multiple files per locale**, merged by locale at generation time.
// ///   - Each file contains `@@locale` and `@@module`.
// ///   - Filenames usually look like: `<prefix>_<module>_<locale>.json`.
// ///   - All module files for the same locale are merged into a single locale map.
// ///   - Rules (recommended):
// ///     - Keys must be unique after merging (no collisions).
// ///     - Placeholders must match across locales under the same merged key.
// ///
// /// Non-modular example (file-set)
// /// - app_en.json
// ///   {
// ///     "@@locale": "en",
// ///     "auth": {
// ///       "login": { "title": "Login" }
// ///     },
// ///     "common": { "ok": "OK" }
// ///   }
// /// - app_id.json
// ///   {
// ///     "@@locale": "id",
// ///     "auth": {
// ///       "login": { "title": "Masuk" }
// ///     },
// ///     "common": { "ok": "OK" }
// ///   }
// ///
// /// Modular example (file-set)
// /// - app_auth_en.json
// ///   {
// ///     "@@locale": "en",
// ///     "@@module": "auth",
// ///     "login": { "title": "Login" }
// ///   }
// /// - app_auth_id.json
// ///   {
// ///     "@@locale": "id",
// ///     "@@module": "auth",
// ///     "login": { "title": "Masuk" }
// ///   }
// /// - app_common_en.json
// ///   {
// ///     "@@locale": "en",
// ///     "@@module": "common",
// ///     "ok": "OK"
// ///   }
// /// - app_common_id.json
// ///   {
// ///     "@@locale": "id",
// ///     "@@module": "common",
// ///     "ok": "OK"
// ///   }
// ///

// ///
// ─────────────────────────────────────────────────────────────────────────────
// CASE INDEX (all cases appear once)
//
//  1) @@locale metadata
//     - Example: @@locale
//
//  2) @@module metadata (modular mode only)
//     - Example: @@module
//
//  3) Basic strings
//     - Example: common.app_title
//
//  4) Nested keys (flatten to dot-keys)
//     - Example: simple.deep.level1.level2.message
//
//  5) Placeholders (named parameters)
//     - Example: placeholders.welcome_user => "Welcome, {name}."
//
//  6) Multiple parameters in one message
//     - Example: placeholders.full_name => "Hello, {first_name} {last_name}."
//
//  7) Parameter reordering across locales
//     - Example: placeholders.items_in_city
//       - EN: "{count} items in {city}."
//       - ID: "Di {city} ada {count} item."
//
//  8) Per-key metadata via @<key> (dartdoc-friendly)
//     - Example: placeholders.@welcome_user
//
//  9) Newline escaping (\\n)
//     - Example: formatting.multiline => "Line 1\\nLine 2"
//
// 10) Quote escaping (\\")
//     - Example: formatting.quotes => "Enable \\\"remember me\\\" ..."
//
// 11) Unicode punctuation
//     - Example: formatting.unicode => contains ’ … –
//
// 12) Literal tokens that must NOT be treated as placeholders
//     - Example: literals.double_curly => "{{08-****-1234}}"
//     - Example: literals.square_brackets => "[x]"
//
// 13) Literal braces "{" and "}" (edge-case for tokenizers)
//     - Example: literals.literal_braces => "{ and }"
//
// 14) Structured localization forms: @plural / @gender / @context
//     - Plural: structured.items.@plural
//     - Gender: structured.user_title.@gender
//     - Context: structured.greeting.@context
//
// Terminology
// - "Key path" means the flattened key produced by nesting, e.g.
//   `simple.deep.level1.level2.message`.
// - "Placeholder" means a named token in `{name}` form.
{
  "@@locale": "en", // (1) Locale metadata (required)

  "common": {
    // (2) Basic strings (no placeholders)
    "app_title": "Demo App",
    "powered_by": "Powered by Alpinnz"
  },

  "simple": {
    // (3) Nested keys
    // Flattened examples:
    // - simple.hello
    // - simple.deep.level1.level2.message
    "hello": "Hello",
    "deep": {
      "level1": {
        "level2": {
          "message": "Deeply nested translation"
        }
      }
    }
  },

  "placeholders": {
    // (4) Placeholders (named parameters)
    // Rule of thumb: keep parameter names identifier-like: {user_id}, {remaining_time}
    // Avoid legacy tokens like {mm:ss} in new strings.
    "welcome_user": "Welcome, {name}.",

    // Different parameter names/types (strings, ints, etc.)
    "attempts_left": "You still have {attempts} attempts left.",
    "remaining_time": "Try again in {remaining_time}.",
    "invalid_character": "Character {char} is not allowed.",

    // (5) Multiple parameters
    "full_name": "Hello, {first_name} {last_name}.",

    // (6) Parameter reordering across locales
    // EN: "{count} items in {city}."
    // ID: "Di {city} ada {count} item."
    // Validation should compare placeholder sets, not order.
    "items_in_city": "{count} items in {city}.",

    // (7) Per-key metadata (goes next to the key)
    // Many localization workflows use this for docs/tooling.
    // The generator may choose to embed this into dartdoc.
    "@welcome_user": {
      "description": "Greets a user by name.",
      "example": "Welcome, John.",
      "placeholders": {
        "name": "User display name"
      }
    },
    "@remaining_time": {
      "description": "Retry hint; {remaining_time} is a preformatted string like 02:15.",
      "example": "Try again in 02:15.",
      "placeholders": {
        "remaining_time": "Time left until retry, already formatted"
      }
    },
    "@items_in_city": {
      "description": "Shows count of items and a city. Locales may reorder placeholders.",
      "example": "12 items in Jakarta.",
      "placeholders": {
        "count": "Item count",
        "city": "City name"
      }
    }
  },

  "formatting": {
    // (8) Newline escaping (\n)
    "multiline": "Line 1\nLine 2",

    // (9) Quote escaping
    "quotes": "Enable \"remember me\" to stay signed in.",

    // (10) Unicode punctuation
    "unicode": "Don’t worry… it’s fine – keep going."
  },

  "literals": {
    // (11) Literal tokens that resemble placeholders
    // Must be treated as literal UI text.
    "double_curly": "Masked phone example: {{08-****-1234}}",
    "square_brackets": "Literal token example: [x]",

    // (12) Literal braces "{" and "}" in a message.
    // Useful for docs/help screens. Tokenizers should NOT interpret these as placeholders.
    "literal_braces": "Use braces like this: { and }"
  },

  "structured": {
    // (13) Structured localization forms, reserved for future needs.

    // Plural example
    "items": {
      "@plural": {
        "zero": "No items",
        "one": "One item",
        "other": "{count} items"
      },
      "@items": {
        "description": "Pluralized item count.",
        "placeholders": {
          "count": "Item count"
        }
      }
    },

    // Gender example
    "user_title": {
      "@gender": {
        "male": "Mr. {last_name}",
        "female": "Ms. {last_name}",
        "other": "Mx. {last_name}"
      },
      "@user_title": {
        "description": "Title selection by gender.",
        "placeholders": {
          "last_name": "Family name"
        }
      }
    },

    // Context/formality example
    "greeting": {
      "@context": {
        "formal": "Good morning, {name}.",
        "casual": "Hi, {name}!"
      },
      "@greeting": {
        "description": "Greeting selection by context (formal vs casual).",
        "placeholders": {
          "name": "User display name"
        }
      }
    }
  }
}
