// /// Localization JSONC reference (Indonesian)
// ///
// /// Summary
// /// - Ini adalah file JSONC **referensi/spec + dataset contoh** untuk locale Indonesia.
// /// - Semua "case" localization ditulis sekali (tidak dobel) dan mirror dengan `assets/app_en.jsonc`.
// /// - Tujuannya: memudahkan developer memahami pola & memudahkan validasi.
// ///
// /// Penggunaan (disarankan)
// /// 1) Baca file ini untuk memahami bentuk data yang didukung.
// /// 2) Simpan terjemahan real di `assets/localizations/*.json` (JSON murni, tanpa komentar).
// /// 3) Aktifkan `strict_validation: true` untuk memastikan:
// ///    - key hasil flatten sama di semua locale
// ///    - placeholder set sama di semua locale
// ///
// /// Contoh
// /// - Akses key nested (secara konsep):
// ///   `simple.deep.level1.level2.message`
// /// - Pemanggilan terjemahan dengan placeholder (Dart, generated API):
// ///   `placeholders.welcome_user(name: 'John')`
// ///
// /// Aturan / Konvensi
// /// - Key adalah API: hindari rename key yang sudah dipakai.
// /// - Placeholder berbentuk `{name}`. Gunakan nama seperti identifier (mis. `{remaining_time}`),
// ///   hindari token legacy seperti `{mm:ss}` untuk string baru.
// /// - Urutan placeholder boleh berbeda antar bahasa, tapi set placeholder harus sama.
// /// - Object `@<key>` adalah metadata block (dartdoc-friendly) untuk `description`, `example`,
// ///   dan dokumentasi placeholder.
// /// - JSONC bisa komentar; **generator membaca `.json`**.
// ///
// /// Modular vs non-modular
// /// - Non-modular (default): **1 file per locale**.
// ///   - Tidak ada konsep "default @@module".
// ///   - Sebagai gantinya, group key menggunakan object di root (mis. `auth`, `common`, `settings`).
// ///   - Key hasil flatten akan menyertakan nama group: `auth.login.title`.
// ///
// /// - Modular: **banyak file per locale**, lalu di-merge berdasarkan locale saat generate.
// ///   - Setiap file berisi `@@locale` dan `@@module`.
// ///   - Nama file biasanya: `<prefix>_<module>_<locale>.json`.
// ///   - Semua file module untuk locale yang sama akan di-merge jadi satu map locale.
// ///   - Aturan (disarankan):
// ///     - Key harus unik setelah merge (hindari collision).
// ///     - Placeholder di key hasil merge harus konsisten antar locale.
// ///
// /// Contoh non-modular (set file)
// /// - app_en.json
// ///   {
// ///     "@@locale": "en",
// ///     "auth": { "login": { "title": "Login" } },
// ///     "common": { "ok": "OK" }
// ///   }
// /// - app_id.json
// ///   {
// ///     "@@locale": "id",
// ///     "auth": { "login": { "title": "Masuk" } },
// ///     "common": { "ok": "OK" }
// ///   }
// ///
// /// Contoh modular (set file)
// /// - app_auth_en.json
// ///   {
// ///     "@@locale": "en",
// ///     "@@module": "auth",
// ///     "login": { "title": "Login" }
// ///    }
// /// - app_auth_id.json
// ///   {
// ///     "@@locale": "id",
// ///     "@@module": "auth",
// ///     "login": { "title": "Masuk" }
// ///    }
// /// - app_common_en.json
// ///   {
// ///     "@@locale": "en",
// ///     "@@module": "common", "ok": "OK"
// ///    }
// /// - app_common_id.json
// ///   {
// ///     "@@locale": "id",
// ///     "@@module": "common",
// ///     "ok": "OK"
// ///    }
// ///
// ─────────────────────────────────────────────────────────────────────────────
// CASE INDEX (all cases appear once)
//
//  1) @@locale metadata
//     - Example: @@locale
//
//  2) @@module metadata (modular mode only)
//     - Example: @@module
//
//  3) Basic strings
//     - Example: common.app_title
//
//  4) Nested keys (flatten to dot-keys)
//     - Example: simple.deep.level1.level2.message
//
//  5) Placeholders (named parameters)
//     - Example: placeholders.welcome_user => "Selamat datang, {name}."
//
//  6) Multiple parameters in one message
//     - Example: placeholders.full_name => "Halo, {first_name} {last_name}."
//
//  7) Parameter reordering across locales
//     - Example: placeholders.items_in_city
//       - EN: "{count} items in {city}."
//       - ID: "Di {city} ada {count} item."
//
//  8) Per-key metadata via @<key> (dartdoc-friendly)
//     - Example: placeholders.@welcome_user
//
//  9) Newline escaping (\\n)
//     - Example: formatting.multiline => "Baris 1\\nBaris 2"
//
// 10) Quote escaping (\\")
//     - Example: formatting.quotes => "Aktifkan \\\"remember me\\\" ..."
//
// 11) Unicode punctuation
//     - Example: formatting.unicode => contains … –
//
// 12) Literal tokens that must NOT be treated as placeholders
//     - Example: literals.double_curly => "{{08-****-1234}}"
//     - Example: literals.square_brackets => "[x]"
//
// 13) Literal braces "{" and "}" (edge-case for tokenizers)
//     - Example: literals.literal_braces => "{ dan }"
//
// 14) Structured localization forms: @plural / @gender / @context
//     - Plural: structured.items.@plural
//     - Gender: structured.user_title.@gender
//     - Context: structured.greeting.@context
{
  "@@locale": "id",

  "common": {
    // Basic strings
    "app_title": "Aplikasi Demo",
    "powered_by": "Didukung oleh Alpinnz"
  },

  "simple": {
    // Nested keys
    "hello": "Halo",
    "deep": {
      "level1": {
        "level2": {
          "message": "Terjemahan dengan struktur bertingkat"
        }
      }
    }
  },

  "placeholders": {
    // Placeholders (named parameters)
    "welcome_user": "Selamat datang, {name}.",
    "attempts_left": "Kamu masih punya {attempts} kesempatan.",
    "remaining_time": "Coba lagi dalam {remaining_time}.",
    "invalid_character": "Karakter {char} tidak diperbolehkan.",

    // Multiple parameters
    "full_name": "Halo, {first_name} {last_name}.",

    // Parameter reordering across locales
    "items_in_city": "Di {city} ada {count} item.",

    // Per-key metadata
    "@welcome_user": {
      "description": "Menyapa user berdasarkan nama.",
      "example": "Selamat datang, John.",
      "placeholders": {
        "name": "Nama tampilan user"
      }
    },
    "@remaining_time": {
      "description": "Petunjuk retry; {remaining_time} adalah string yang sudah terformat seperti 02:15.",
      "example": "Coba lagi dalam 02:15.",
      "placeholders": {
        "remaining_time": "Sisa waktu untuk retry, sudah terformat"
      }
    },
    "@items_in_city": {
      "description": "Menampilkan jumlah item dan nama kota. Urutan placeholder bisa berbeda antar bahasa.",
      "example": "Di Jakarta ada 12 item.",
      "placeholders": {
        "count": "Jumlah item",
        "city": "Nama kota"
      }
    }
  },

  "formatting": {
    // Newline escape
    "multiline": "Baris 1\nBaris 2",

    // Quote escaping
    "quotes": "Aktifkan \"remember me\" agar tetap masuk.",

    // Unicode punctuation
    "unicode": "Jangan khawatir… tidak apa-apa – lanjutkan."
  },

  "literals": {
    // Literal tokens (not placeholders)
    "double_curly": "Contoh nomor tersamarkan: {{08-****-1234}}",
    "square_brackets": "Contoh token literal: [x]",

    // Literal braces
    "literal_braces": "Gunakan kurung kurawal seperti ini: { dan }"
  },

  "structured": {
    // Plural
    "items": {
      "@plural": {
        "zero": "Tidak ada item",
        "one": "Satu item",
        "other": "{count} item"
      },
      "@items": {
        "description": "Bentuk plural untuk jumlah item.",
        "placeholders": {
          "count": "Jumlah item"
        }
      }
    },

    // Gender
    "user_title": {
      "@gender": {
        "male": "Tn. {last_name}",
        "female": "Nn. {last_name}",
        "other": "Sdr. {last_name}"
      },
      "@user_title": {
        "description": "Pemilihan sapaan berdasarkan gender.",
        "placeholders": {
          "last_name": "Nama belakang"
        }
      }
    },

    // Context/formality
    "greeting": {
      "@context": {
        "formal": "Selamat pagi, {name}.",
        "casual": "Hai, {name}!"
      },
      "@greeting": {
        "description": "Pemilihan greeting berdasarkan context (formal vs santai).",
        "placeholders": {
          "name": "Nama tampilan user"
        }
      }
    }
  }
}
